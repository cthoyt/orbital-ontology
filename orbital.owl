    <!-- http://purl.obolibrary.org/NCBITaxon_9606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/NCBITaxon_9606">
        <rdfs:label>human</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/biopragmatics/orbital/term/0000001 -->

    <owl:Class rdf:about="http://w3id.org/biopragmatics/orbital/term/0000001">
        <rdfs:label>atomic orbital</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/biopragmatics/orbital/term/0000002 -->

    <owl:Class rdf:about="http://w3id.org/biopragmatics/orbital/term/0000002">
        <rdfs:subClassOf rdf:resource="http://w3id.org/biopragmatics/orbital/term/0000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/biopragmatics/orbital/term/1000000"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>atomic orbital by principle quantum number</rdfs:label>
    </owl:Class>
    


