<?xml version="1.0"?>
<rdf:RDF xmlns="https://github.com/cthoyt/orbital-ontology/raw/refs/heads/main/orbital.owl#"
     xml:base="https://github.com/cthoyt/orbital-ontology/raw/refs/heads/main/orbital.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:doap="http://usefulinc.com/ns/doap#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://github.com/cthoyt/orbital-ontology/raw/refs/heads/main/orbital.owl">
        <dcterms:creator rdf:resource="https://orcid.org/0000-0003-4423-4370"/>
        <dcterms:description>An ontology for atomic orbitals, molecular orbitals, and other orbitals.</dcterms:description>
        <dcterms:license rdf:resource="https://spdx.org/licenses/CC0-1.0"/>
        <dcterms:title>Orbital Ontology</dcterms:title>
        <doap:Repository rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/cthoyt/orbital-ontology</doap:Repository>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://usefulinc.com/ns/doap#Repository -->

    <owl:AnnotationProperty rdf:about="http://usefulinc.com/ns/doap#Repository"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://w3id.org/biopragmatics/orbital/term/1000000 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/biopragmatics/orbital/term/1000000">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/biopragmatics/orbital/term/0000001"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <dcterms:description>n, takes on natural values [1,2,3,...)</dcterms:description>
        <rdfs:label>has principal quantum number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/biopragmatics/orbital/term/1000001 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/biopragmatics/orbital/term/1000001">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/biopragmatics/orbital/term/0000001"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <dcterms:description>l, takes on non-negative integer values between [0, n-1]</dcterms:description>
        <rdfs:label>has azimuthal quantum number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/biopragmatics/orbital/term/1000002 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/biopragmatics/orbital/term/1000002">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/biopragmatics/orbital/term/0000001"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dcterms:description>m_l, takes on integer values between [-l, l]</dcterms:description>
        <rdfs:label>has magnetic quantum number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/biopragmatics/orbital/term/1000003 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/biopragmatics/orbital/term/1000003">
        <dcterms:description>m_s, for an electron can be one of {-1/2, 1/2}</dcterms:description>
        <rdfs:label>has spin magnetic quantum number</rdfs:label>
    </owl:DatatypeProperty>
    


